{
  "name": "kakeibo-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:mac": "electron-builder --mac dmg",
    "dist:all": "electron-builder -mwl"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron": "^39.0.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.example.kakeibo",
    "productName": "Kakeibo",
    "files": [
      "**/*",
      "!node_modules/.cache/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "backgroundColor": "#ffffff",
      "contents": [
        { "x": 130, "y": 150, "type": "file" },
        { "x": 410, "y": 150, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
